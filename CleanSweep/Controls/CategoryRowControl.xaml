<UserControl x:Class="CleanSweep.Controls.CategoryRowControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:CleanSweep.Controls">
    <Border x:Name="CardBorder"
            Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="10"
            Padding="14,12"
            Margin="0,0,0,8">
        <Border.Style>
            <Style TargetType="Border">
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{StaticResource SurfaceHoverBrush}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Checkbox -->
            <CheckBox x:Name="CategoryCheckBox"
                      Grid.Column="0"
                      Style="{StaticResource CustomCheckBoxStyle}"
                      VerticalAlignment="Center"
                      Checked="OnCheckedStateChanged"
                      Unchecked="OnCheckedStateChanged"/>

            <!-- Monochrome Vector Icon -->
            <controls:CategoryIcon x:Name="IconControl"
                                   Grid.Column="1"
                                   Margin="12,0,0,0"
                                   VerticalAlignment="Center"/>

            <!-- Name and Description -->
            <StackPanel Grid.Column="2"
                        Margin="12,0,12,0"
                        VerticalAlignment="Center">
                <TextBlock x:Name="NameText"
                           FontFamily="Segoe UI"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextBrush}"/>
                <TextBlock x:Name="DescText"
                           FontFamily="Segoe UI"
                           FontSize="11"
                           Foreground="{StaticResource TextDimBrush}"
                           TextWrapping="Wrap"
                           Margin="0,2,0,0"/>
            </StackPanel>

            <!-- Size / Status -->
            <TextBlock x:Name="SizeText"
                       Grid.Column="3"
                       FontFamily="Segoe UI"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource AccentBrush}"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"
                       MinWidth="80"
                       TextAlignment="Right"
                       Text="…"/>
        </Grid>
    </Border>
</UserControl>

