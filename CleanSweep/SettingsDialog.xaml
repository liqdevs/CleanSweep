<Window x:Class="CleanSweep.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings"
        Width="340"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource BackgroundBrush}">
    <Border Padding="24,22">
        <StackPanel>
            <!-- Language Label -->
            <TextBlock x:Name="LanguageLabel"
                       FontFamily="Segoe UI"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource TextBrush}"
                       Margin="0,0,0,6"/>

            <!-- Language ComboBox -->
            <ComboBox x:Name="LanguageComboBox"
                      SelectionChanged="OnLanguageSelectionChanged"
                      Margin="0,0,0,16"/>

            <!-- Disk Label -->
            <TextBlock x:Name="DiskLabel"
                       FontFamily="Segoe UI"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource TextBrush}"
                       Margin="0,0,0,6"/>

            <!-- Disk ComboBox -->
            <ComboBox x:Name="DiskComboBox"
                      SelectionChanged="OnDiskSelectionChanged"
                      Margin="0,0,0,6"/>

            <!-- Disk Hint -->
            <TextBlock x:Name="DiskHintText"
                       FontFamily="Segoe UI"
                       FontSize="11"
                       Foreground="{StaticResource TextFaintBrush}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,20"/>

            <!-- Close Button -->
            <Button x:Name="CloseButton"
                    Style="{StaticResource ScanButtonStyle}"
                    HorizontalAlignment="Stretch"
                    Click="OnCloseClicked"/>
        </StackPanel>
    </Border>
</Window>

