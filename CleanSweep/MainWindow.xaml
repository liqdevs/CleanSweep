<Window x:Class="CleanSweep.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:CleanSweep.Controls"
        Title="CleanSweep"
        Icon="Assets/CleanSweep.ico"
        Width="760"
        Height="680"
        MinWidth="560"
        MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1. Header: Title + Startup & Settings Buttons -->
        <Grid Grid.Row="0" Margin="28,22,28,8">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Image Source="Assets/CleanSweepLogo.png"
                       Width="36"
                       Height="36"
                       Stretch="Uniform"
                       Margin="0,0,10,0"/>
                <TextBlock x:Name="HeaderTitle"
                           Text="CleanSweep"
                           FontFamily="Segoe UI"
                           FontSize="22"
                           FontWeight="SemiBold"
                           Foreground="#F2F4F8"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button x:Name="DiskStatsBtn"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Padding="12,8"
                        Margin="0,0,8,0"
                        Click="OnDiskStatsClicked"/>
                <controls:IconButton x:Name="StartupBtn"
                                     IconKind="Startup"
                                     Margin="0,0,6,0"
                                     Click="OnStartupClicked"/>
                <controls:IconButton x:Name="SettingsBtn"
                                     IconKind="Settings"
                                     Click="OnSettingsClicked"/>
            </StackPanel>
        </Grid>

        <!-- 2. Scan Area: Ring, Disk Free Space, Find Junk Button -->
        <StackPanel Grid.Row="1" Margin="28,8,28,12" HorizontalAlignment="Center">
            <controls:ScanRing x:Name="MainScanRing" HorizontalAlignment="Center"/>

            <TextBlock x:Name="DiskLabel"
                       FontFamily="Segoe UI"
                       FontSize="11"
                       Foreground="{StaticResource TextFaintBrush}"
                       HorizontalAlignment="Center"
                       Margin="0,10,0,14"/>

            <Button x:Name="ScanBtn"
                    Style="{StaticResource ScanButtonStyle}"
                    HorizontalAlignment="Center"
                    Click="OnScanClicked"/>
        </StackPanel>

        <!-- 3. Scrollable Category List -->
        <ScrollViewer Grid.Row="2"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="CategoriesPanel" Margin="28,4,28,12"/>
        </ScrollViewer>

        <!-- 4. Footer Bar: Selected count/size and Clean Button -->
        <Border x:Name="FooterBar"
                Grid.Row="3"
                Background="#171B22"
                BorderThickness="0,1,0,0"
                BorderBrush="{StaticResource BorderBrush}"
                Padding="28,14"
                Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,14,0">
                    <TextBlock x:Name="FooterLabel"
                               FontFamily="Segoe UI"
                               FontSize="12"
                               Foreground="{StaticResource TextDimBrush}"/>
                    <TextBlock x:Name="HintLabel"
                               FontFamily="Segoe UI"
                               FontSize="10"
                               Foreground="{StaticResource TextFaintBrush}"
                               Margin="0,2,0,0"/>
                </StackPanel>

                <Button x:Name="CleanBtn"
                        Grid.Column="1"
                        Style="{StaticResource CleanButtonStyle}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Click="OnCleanClicked"/>
            </Grid>
        </Border>
    </Grid>
</Window>
