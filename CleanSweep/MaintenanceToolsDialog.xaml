<Window x:Class="CleanSweep.MaintenanceToolsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cleanup tools"
        Width="900"
        Height="680"
        MinWidth="680"
        MinHeight="520"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource BackgroundBrush}">
    <Window.Resources>
        <Style TargetType="{x:Type TabControl}">
            <Setter Property="Background" Value="{StaticResource BackgroundBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style TargetType="{x:Type TabItem}">
            <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TabItem}">
                        <Border x:Name="TabBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8,8,0,0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="{StaticResource SurfaceHoverBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock x:Name="TitleText"
                       FontFamily="Segoe UI"
                       FontSize="21"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource TextBrush}"/>
            <TextBlock x:Name="SubtitleText"
                       FontFamily="Segoe UI"
                       FontSize="12"
                       Foreground="{StaticResource TextDimBrush}"
                       Margin="0,4,0,0"/>
        </StackPanel>

        <TabControl Grid.Row="1">
            <TabItem x:Name="DuplicatesTab">
                <TabItem.Header>
                    <TextBlock x:Name="DuplicatesTabText"/>
                </TabItem.Header>
                <Grid Margin="0,16,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="DuplicatesHint"
                               Foreground="{StaticResource TextDimBrush}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,12"/>
                    <Grid Grid.Row="1" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="DuplicateRootBox" VerticalContentAlignment="Center"/>
                        <Button x:Name="BrowseDuplicatesButton"
                                Grid.Column="1"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Padding="12,7"
                                Margin="8,0,8,0"
                                Click="OnBrowseDuplicatesClicked"/>
                        <Button x:Name="ScanDuplicatesButton"
                                Grid.Column="2"
                                Style="{StaticResource ScanButtonStyle}"
                                Padding="16,8"
                                Click="OnScanDuplicatesClicked"/>
                    </Grid>
                    <Border Grid.Row="2"
                            Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="8">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="DuplicateResultsPanel"/>
                        </ScrollViewer>
                    </Border>
                    <Grid Grid.Row="3" Margin="0,12,0,0">
                        <TextBlock x:Name="DuplicateStatus"
                                   Foreground="{StaticResource TextDimBrush}"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="SelectDuplicateCopiesButton"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Padding="12,8"
                                    Margin="0,0,8,0"
                                    Click="OnSelectDuplicateCopiesClicked"/>
                            <Button x:Name="DeleteDuplicateButton"
                                    Style="{StaticResource CleanButtonStyle}"
                                    Padding="16,8"
                                    IsEnabled="False"
                                    Click="OnDeleteDuplicatesClicked"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem x:Name="EmptyFoldersTab">
                <TabItem.Header>
                    <TextBlock x:Name="EmptyFoldersTabText"/>
                </TabItem.Header>
                <Grid Margin="0,16,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="EmptyFoldersHint"
                               Foreground="{StaticResource TextDimBrush}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,12"/>
                    <Grid Grid.Row="1" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="EmptyFolderRootBox" VerticalContentAlignment="Center"/>
                        <Button x:Name="BrowseEmptyButton"
                                Grid.Column="1"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Padding="12,7"
                                Margin="8,0,8,0"
                                Click="OnBrowseEmptyClicked"/>
                        <Button x:Name="ScanEmptyButton"
                                Grid.Column="2"
                                Style="{StaticResource ScanButtonStyle}"
                                Padding="16,8"
                                Click="OnScanEmptyClicked"/>
                    </Grid>
                    <Border Grid.Row="2"
                            Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="8">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="EmptyFolderResultsPanel"/>
                        </ScrollViewer>
                    </Border>
                    <Grid Grid.Row="3" Margin="0,12,0,0">
                        <TextBlock x:Name="EmptyFolderStatus"
                                   Foreground="{StaticResource TextDimBrush}"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap"/>
                        <Button x:Name="DeleteEmptyButton"
                                Style="{StaticResource CleanButtonStyle}"
                                Padding="16,8"
                                HorizontalAlignment="Right"
                                IsEnabled="False"
                                Click="OnDeleteEmptyClicked"/>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>

        <Button x:Name="CloseButton"
                Grid.Row="2"
                Style="{StaticResource SecondaryButtonStyle}"
                MinWidth="96"
                HorizontalAlignment="Right"
                Margin="0,16,0,0"
                Click="OnCloseClicked"/>
    </Grid>
</Window>
