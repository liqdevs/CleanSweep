<Window x:Class="CleanSweep.DiskStatisticsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Disk usage"
        Width="820"
        Height="650"
        MinWidth="640"
        MinHeight="480"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource BackgroundBrush}"
        Loaded="OnLoaded"
        Closing="OnClosing">
    <Window.Resources>
        <Style x:Key="DarkListViewStyle" TargetType="{x:Type ListView}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListView}">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer Padding="{TemplateBinding Padding}"
                                          Background="{TemplateBinding Background}"
                                          Focusable="False"
                                          CanContentScroll="True">
                                <ItemsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                            </ScrollViewer>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock x:Name="TitleText"
                       FontFamily="Segoe UI"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource TextBrush}"/>
            <TextBlock x:Name="DriveText"
                       FontFamily="Segoe UI"
                       FontSize="12"
                       Foreground="{StaticResource TextDimBrush}"
                       Margin="0,4,0,0"/>
        </StackPanel>

        <Border Grid.Row="1"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="16"
                Margin="0,0,0,12">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock x:Name="CapacityLabel" FontSize="11" Foreground="{StaticResource TextFaintBrush}"/>
                        <TextBlock x:Name="CapacityValue" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,3,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock x:Name="UsedLabel" FontSize="11" Foreground="{StaticResource TextFaintBrush}"/>
                        <TextBlock x:Name="UsedValue" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,3,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock x:Name="FreeLabel" FontSize="11" Foreground="{StaticResource TextFaintBrush}"/>
                        <TextBlock x:Name="FreeValue" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,3,0,0"/>
                    </StackPanel>
                </Grid>
                <Grid x:Name="CapacityBar" Height="8" Background="{StaticResource BorderBrush}" ClipToBounds="True" Margin="0,12,0,0">
                    <Border x:Name="UsedBar" HorizontalAlignment="Left" Background="{StaticResource AccentBrush}"/>
                </Grid>
                <TextBlock x:Name="ScanSummaryText"
                           FontSize="11"
                           Foreground="{StaticResource TextDimBrush}"
                           Margin="0,10,0,0"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="2" Margin="0,0,0,12">
            <ProgressBar x:Name="ScanProgress" Height="4" IsIndeterminate="True" Visibility="Collapsed"/>
            <TextBlock x:Name="StatusText"
                       FontSize="11"
                       Foreground="{StaticResource TextDimBrush}"
                       TextTrimming="CharacterEllipsis"
                       Margin="0,6,0,0"/>
        </StackPanel>

        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="220"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="UpButton"
                        Grid.Column="0"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Padding="12,7"
                        Margin="0,0,10,0"
                        Click="OnUpClicked"/>
                <TextBlock x:Name="CurrentPathText"
                           Grid.Column="1"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource TextDimBrush}"
                           TextTrimming="CharacterEllipsis"/>
                <TextBox x:Name="FileSearchBox"
                         Grid.Column="2"
                         Height="34"
                         Padding="10,6"
                         Background="{StaticResource SurfaceBrush}"
                         Foreground="{StaticResource TextBrush}"
                         BorderBrush="{StaticResource BorderBrush}"
                         BorderThickness="1"
                         VerticalContentAlignment="Center"
                         TextChanged="OnFileSearchChanged"/>
            </Grid>
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="FoldersTitle" Grid.Row="0" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,6"/>
                    <ListView x:Name="FoldersList"
                              Grid.Row="1"
                              Style="{StaticResource DarkListViewStyle}"
                              MouseDoubleClick="OnFolderDoubleClick"
                              Background="{StaticResource SurfaceBrush}"
                              Foreground="{StaticResource TextBrush}"
                              BorderBrush="{StaticResource BorderBrush}"
                              BorderThickness="1">
                        <ListView.Resources>
                            <Style TargetType="{x:Type TextBlock}">
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </ListView.Resources>
                        <ListView.ItemContainerStyle>
                            <Style TargetType="{x:Type ListViewItem}">
                                <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                                <Setter Property="Padding" Value="5,4"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="{x:Type ListViewItem}">
                                            <Border x:Name="RowBorder" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}" Margin="2,1">
                                                <GridViewRowPresenter Content="{TemplateBinding Content}" Columns="{Binding Path=View.Columns, RelativeSource={RelativeSource AncestorType={x:Type ListView}}}"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="RowBorder" Property="Background" Value="#245C75"/>
                                                    <Setter TargetName="RowBorder" Property="BorderBrush" Value="#7DD3FC"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="RowBorder" Property="Background" Value="#2B3948"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Width="34">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      IsEnabled="{Binding CanDelete}"
                                                      ToolTip="{Binding DeleteToolTip}"
                                                      Click="OnFolderCheckChanged"
                                                      PreviewMouseDoubleClick="OnFolderCheckboxDoubleClick"
                                                      HorizontalAlignment="Center">
                                                <CheckBox.Style>
                                                    <Style TargetType="{x:Type CheckBox}" BasedOn="{StaticResource CustomCheckBoxStyle}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding CanDelete}" Value="False">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </CheckBox.Style>
                                            </CheckBox>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn x:Name="FolderNameColumn" Width="210" DisplayMemberBinding="{Binding Name}"/>
                                <GridViewColumn x:Name="FolderSizeColumn" Width="85" DisplayMemberBinding="{Binding SizeText}"/>
                                <GridViewColumn x:Name="FolderCountColumn" Width="70" DisplayMemberBinding="{Binding FileCountText}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Grid>
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="LargestFilesTitle" Grid.Row="0" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,6"/>
                    <ListView x:Name="LargestFilesList"
                              Grid.Row="1"
                              Style="{StaticResource DarkListViewStyle}"
                              GridViewColumnHeader.Click="OnFilesHeaderClick"
                              Background="{StaticResource SurfaceBrush}"
                              Foreground="{StaticResource TextBrush}"
                              BorderBrush="{StaticResource BorderBrush}"
                              BorderThickness="1">
                        <ListView.Resources>
                            <Style TargetType="{x:Type TextBlock}">
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </ListView.Resources>
                        <ListView.ItemContainerStyle>
                            <Style TargetType="{x:Type ListViewItem}">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="{x:Type ListViewItem}">
                                            <Border x:Name="RowBorder" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="1" CornerRadius="7" Padding="2,3">
                                                <GridViewRowPresenter Content="{TemplateBinding Content}" Columns="{Binding Path=View.Columns, RelativeSource={RelativeSource AncestorType={x:Type ListView}}}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="RowBorder" Property="Background" Value="{StaticResource SelectionBrush}"/>
                                                    <Setter TargetName="RowBorder" Property="BorderBrush" Value="{StaticResource SelectionBorderBrush}"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="RowBorder" Property="Background" Value="#2B3948"/>
                                                </Trigger>
                                                <MultiTrigger>
                                                    <MultiTrigger.Conditions>
                                                        <Condition Property="IsSelected" Value="True"/>
                                                        <Condition Property="IsMouseOver" Value="True"/>
                                                    </MultiTrigger.Conditions>
                                                    <Setter TargetName="RowBorder" Property="Background" Value="#2F718B"/>
                                                </MultiTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.View>
                            <GridView>
                                <GridViewColumn x:Name="FileSelectColumn" Width="34">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource CustomCheckBoxStyle}" Click="OnFileCheckChanged" HorizontalAlignment="Center"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn x:Name="FilePathColumn" Width="230" Header="Name" DisplayMemberBinding="{Binding DisplayPath}"/>
                                <GridViewColumn x:Name="FileSizeColumn" Width="75" Header="Size" DisplayMemberBinding="{Binding SizeText}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Grid>
            </Grid>
        </Grid>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="DeleteSelectedButton"
                    Style="{StaticResource CleanButtonStyle}"
                    Margin="0,0,10,0"
                    Padding="18,9"
                    IsEnabled="False"
                    Click="OnDeleteSelectedClicked"/>
            <Button x:Name="CloseButton"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Padding="22,9"
                    Click="OnCloseClicked"/>
        </StackPanel>
    </Grid>
</Window>
